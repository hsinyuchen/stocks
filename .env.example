APP_NAME="Stock Market Analysis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

# 改用 MySQL 時：DB_CONNECTION=mysql，並把 DB_DATABASE 換成資料庫名稱
# （留著 database/database.sqlite 會被當成資料庫名，錯誤訊息很難聯想）。
#
# DB_ENGINE 預設 InnoDB，一般不必設。只有在需要覆寫時才動它——伺服器的
# default_storage_engine 若是 MyISAM，外鍵會被靜默忽略，見 config/database.php。
# DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# AI 分析在佇列執行。能跑常駐 worker（queue:work）或每分鐘 schedule:run 的環境，
# 把 ANALYSIS_INLINE_WORKER 設為 false 走正規 worker。
# 兩者都沒有時維持 true：改由 web request 在回應送出後順帶取件，代價是受 PHP 的
# max_execution_time 影響，長 prompt 可能被砍斷。
ANALYSIS_INLINE_WORKER=true
ANALYSIS_INLINE_WORKER_SECONDS=60
ANALYSIS_INLINE_WORKER_MAX_JOBS=2
# LLM 呼叫逾時下限（秒）。與上面的預算相加就是單次 request 最壞情況的耗時，
# 必須小於主機的 max_execution_time。跑 `php artisan queue:doctor` 會直接印出
# 「最壞情況需要」幾秒，不必自己算。只用雲端模型時 60～90 已經很寬鬆。
ANALYSIS_LLM_TIMEOUT_FLOOR=120
# 排隊超過這個時間仍未執行的分析，自動標記失敗並作廢對應的 job。
# 必須小於前端輪詢的放棄門檻（10 分鐘）。
ANALYSIS_PENDING_TIMEOUT_MINUTES=8

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 公開主機部署時設 false 關閉自助註冊，僅 admin 可建帳號。
REGISTRATION_ENABLED=true

NEWS_DRIVER=db

# 新聞保留 90 天。依實測約 300 則/日推算，穩定後約 2.7 萬筆、20 MB 上下。
# 舊新聞不進任何分析 prompt，縮短保留期不影響當前判讀；但過期就再也抓不回來
# （各家 RSS 只暴露最近窗口），日後若要做事件回顧或訊號回測，缺的那段補不回來。
NEWS_RETENTION_DAYS=90

# feed 健康度：連續幾次抓不到新鮮內容才判定失效，以及「新鮮」的定義（天）。
# 新鮮窗口刻意與保留窗口脫鉤——保留窗口決定資料存多久，健康度回答上游是否
# 還活著。用保留窗口當基準會在 retention 拉長後失去偵測力。
NEWS_FEED_STALE_RUNS=6
NEWS_FEED_FRESH_WITHIN_DAYS=7

# 單次 prune 刪除量超過此值才執行 VACUUM 把空間還給磁碟。
# SQLite 的 DELETE 不會縮小檔案；VACUUM 會鎖庫重寫，不適合每次抓取都跑。0 = 停用。
NEWS_VACUUM_AFTER_PRUNED=500

# 個股新聞（Google News RSS）：個股頁載入時依 symbol 同步抓取，故 timeout 較短。
# freshness 為每 symbol 的抓取節流窗口（分鐘），窗口內不重抓，避免抓取風暴。
NEWS_SYMBOL_HTTP_TIMEOUT=8
NEWS_SYMBOL_FRESHNESS_MINUTES=60

# YouTube captions ingestion (slice 2C). Discovery via channel RSS (no API key);
# captions via youtube-transcript-api in scripts/.venv. YOUTUBE_PYTHON defaults to
# the venv python; override for other setups (e.g. scripts/.venv/bin/python).
YOUTUBE_INGEST_ENABLED=true
YOUTUBE_PYTHON=
YOUTUBE_PER_CHANNEL_LIMIT=5
YOUTUBE_EXCERPT_CHARS=1500

# Market data: 'live' uses FinMind (TW) + Stooq (US) + Yahoo fallback with a shared DB cache.
# Tests force 'fake' via phpunit.xml.
MARKET_DATA_DRIVER=live
MARKET_DATA_CACHE_TTL_MINUTES=720
# Short shared cache (seconds) for live intraday quotes; coalesces concurrent users into one upstream call.
MARKET_DATA_QUOTE_CACHE_SECONDS=60
# Optional FinMind token raises Taiwan-data rate limits (https://finmindtrade.com/).
FINMIND_TOKEN=

# 台股基本面快取新鮮度（小時）。財報季更、月營收月更，變動慢，用長 TTL；
# 抓取失敗（全 null 列）改用短 failure TTL，避免對故障的 FinMind 每次開頁重打。
FUNDAMENTALS_TTL_HOURS=24
FUNDAMENTALS_FAILURE_TTL_HOURS=2

# 台股籌碼面（三大法人買賣超，FinMind）。收盤後才公佈，盤中不變動，
# 故 TTL 以小時計即可涵蓋一個交易日。HISTORY_DAYS 為日曆日，60 日約 40 個交易日。
CHIP_TTL_HOURS=12
CHIP_FAILURE_TTL_HOURS=2
CHIP_HISTORY_DAYS=60

# LLM API keys are NOT set here. Each user adds their own provider + key in the
# in-app Settings page; keys are stored encrypted per user (Hermes-style multi-model).
